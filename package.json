{
  "name": "repo-tree",
  "displayName": "Repository Tree",
  "description": "Nested tree of git repositories in the Source Control sidebar",
  "version": "0.3.0",
  "publisher": "benallfree",
  "repository": {
    "type": "git",
    "url": "https://github.com/benallfree/repo-tree"
  },
  "bugs": {
    "url": "https://github.com/benallfree/repo-tree/issues"
  },
  "homepage": "https://github.com/benallfree/repo-tree#readme",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:repoTree.repositories"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "scm": [
        {
          "id": "repoTree.repositories",
          "name": "Repository Tree"
        }
      ]
    },
    "commands": [
      {
        "command": "repoTree.refresh",
        "title": "Refresh Repository Tree",
        "icon": "$(refresh)"
      },
      {
        "command": "repoTree.setLayoutTree",
        "title": "Tree Layout",
        "icon": "$(list-tree)"
      },
      {
        "command": "repoTree.setLayoutFlat",
        "title": "Flat Layout",
        "icon": "$(list-flat)"
      },
      {
        "command": "repoTree.setSortName",
        "title": "Sort by Name",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "repoTree.setSortWip",
        "title": "Sort by Recent WIP",
        "icon": "$(history)"
      },
      {
        "command": "repoTree.toggleHideUnchanged",
        "title": "Hide Unchanged Repositories",
        "icon": "$(filter)",
        "toggled": {
          "condition": "repoTree.hideUnchanged",
          "icon": "$(filter-filled)",
          "title": "Show All Repositories",
          "tooltip": "Showing repositories with local changes only"
        }
      },
      {
        "command": "repoTree.revealInExplorer",
        "title": "Reveal in Explorer"
      },
      {
        "command": "repoTree.openInNewWindow",
        "title": "Open Repository in New Window"
      },
      {
        "command": "repoTree.gitSync",
        "title": "Sync",
        "icon": "$(sync)"
      },
      {
        "command": "repoTree.gitSyncBusy",
        "title": "Syncing",
        "icon": "$(sync~spin)"
      },
      {
        "command": "repoTree.gitRefresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "repoTree.gitPull",
        "title": "Pull",
        "icon": "$(arrow-down)"
      },
      {
        "command": "repoTree.gitPush",
        "title": "Push",
        "icon": "$(arrow-up)"
      },
      {
        "command": "repoTree.commit",
        "title": "Commit",
        "icon": "$(check)"
      },
      {
        "command": "repoTree.stageFile",
        "title": "Stage",
        "icon": "$(add)"
      },
      {
        "command": "repoTree.unstageFile",
        "title": "Unstage",
        "icon": "$(remove)"
      },
      {
        "command": "repoTree.discardFile",
        "title": "Discard",
        "icon": "$(discard)"
      },
      {
        "command": "repoTree.stageAllInScope",
        "title": "Stage All",
        "icon": "$(add)"
      },
      {
        "command": "repoTree.unstageAllInScope",
        "title": "Unstage All",
        "icon": "$(remove)"
      },
      {
        "command": "repoTree.discardAllInScope",
        "title": "Discard All",
        "icon": "$(discard)"
      },
      {
        "command": "repoTree.addToGitignore",
        "title": "Add to .gitignore"
      },
      {
        "command": "repoTree.openDiff",
        "title": "Open Diff"
      },
      {
        "command": "repoTree.openFile",
        "title": "Open File",
        "icon": "$(go-to-file)"
      },
      {
        "command": "repoTree.viewGitGraph",
        "title": "View Git Graph",
        "icon": "$(git-commit)"
      },
      {
        "command": "repoTree.viewCommitGraph",
        "title": "Show Commit Graph",
        "icon": "$(gitlens-graph)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "repoTree.setLayoutTree",
          "when": "view == repoTree.repositories && repoTree.layout == flat",
          "group": "navigation@1"
        },
        {
          "command": "repoTree.setLayoutFlat",
          "when": "view == repoTree.repositories && repoTree.layout == tree",
          "group": "navigation@1"
        },
        {
          "command": "repoTree.setSortName",
          "when": "view == repoTree.repositories && repoTree.sortMode == wip",
          "group": "navigation@2"
        },
        {
          "command": "repoTree.setSortWip",
          "when": "view == repoTree.repositories && repoTree.sortMode == name",
          "group": "navigation@2"
        },
        {
          "command": "repoTree.toggleHideUnchanged",
          "when": "view == repoTree.repositories",
          "group": "navigation@3"
        },
        {
          "command": "repoTree.refresh",
          "when": "view == repoTree.repositories",
          "group": "navigation@4"
        },
        {
          "command": "repoTree.gitSyncBusy",
          "when": "view == repoTree.repositories && repoTree.selectionKind == repo && repoTree.repoSyncing && config.git.enabled && !git.missing",
          "group": "navigation@10"
        },
        {
          "command": "repoTree.gitSync",
          "when": "view == repoTree.repositories && repoTree.selectionKind == repo && !repoTree.repoSyncing && config.git.enabled && !git.missing",
          "group": "navigation@10"
        },
        {
          "command": "repoTree.commit",
          "when": "view == repoTree.repositories && repoTree.selectionKind == repo && config.git.enabled && !git.missing",
          "group": "navigation@11"
        },
        {
          "command": "repoTree.gitRefresh",
          "when": "view == repoTree.repositories && repoTree.selectionKind == repo && config.git.enabled && !git.missing",
          "group": "navigation@12"
        },
        {
          "submenu": "repoTree.repoMore",
          "when": "view == repoTree.repositories && repoTree.selectionKind == repo",
          "group": "navigation@13"
        },
        {
          "command": "repoTree.stageFile",
          "when": "view == repoTree.repositories && repoTree.selectionKind == file.changes && config.git.enabled && !git.missing",
          "group": "2_git@1"
        },
        {
          "command": "repoTree.stageFile",
          "when": "view == repoTree.repositories && repoTree.selectionKind == file.merge && config.git.enabled && !git.missing",
          "group": "2_git@1"
        },
        {
          "command": "repoTree.unstageFile",
          "when": "view == repoTree.repositories && repoTree.selectionKind == file.staged && config.git.enabled && !git.missing",
          "group": "2_git@1"
        },
        {
          "command": "repoTree.stageAllInScope",
          "when": "view == repoTree.repositories && (repoTree.selectionKind == section.changes || repoTree.selectionKind == dir.changes) && config.git.enabled && !git.missing",
          "group": "2_git@1"
        },
        {
          "command": "repoTree.stageAllInScope",
          "when": "view == repoTree.repositories && (repoTree.selectionKind == section.merge || repoTree.selectionKind == dir.merge) && config.git.enabled && !git.missing",
          "group": "2_git@1"
        },
        {
          "command": "repoTree.unstageAllInScope",
          "when": "view == repoTree.repositories && (repoTree.selectionKind == section.staged || repoTree.selectionKind == dir.staged) && config.git.enabled && !git.missing",
          "group": "2_git@1"
        },
        {
          "command": "repoTree.discardFile",
          "when": "view == repoTree.repositories && repoTree.selectionKind == file.changes && config.git.enabled && !git.missing",
          "group": "2_git@2"
        },
        {
          "command": "repoTree.discardAllInScope",
          "when": "view == repoTree.repositories && (repoTree.selectionKind == section.changes || repoTree.selectionKind == dir.changes) && config.git.enabled && !git.missing",
          "group": "2_git@2"
        },
        {
          "command": "repoTree.openDiff",
          "when": "view == repoTree.repositories && repoTree.selectionKind =~ /^file\\./",
          "group": "2_git@3"
        },
        {
          "command": "repoTree.openFile",
          "when": "view == repoTree.repositories && repoTree.selectionKind =~ /^file\\./ && config.git.enabled && !git.missing",
          "group": "2_git@4"
        }
      ],
      "view/item/context": [
        {
          "command": "repoTree.gitSyncBusy",
          "when": "view == repoTree.repositories && viewItem == repoTree.repo.syncing && config.git.enabled && !git.missing",
          "group": "inline@1"
        },
        {
          "command": "repoTree.gitSync",
          "when": "view == repoTree.repositories && viewItem == repoTree.repo && config.git.enabled && !git.missing",
          "group": "inline@1"
        },
        {
          "command": "repoTree.commit",
          "when": "view == repoTree.repositories && viewItem == repoTree.repo && config.git.enabled && !git.missing",
          "group": "inline@2"
        },
        {
          "command": "repoTree.gitRefresh",
          "when": "view == repoTree.repositories && viewItem == repoTree.repo && config.git.enabled && !git.missing",
          "group": "inline@3"
        },
        {
          "command": "repoTree.viewGitGraph",
          "when": "view == repoTree.repositories && viewItem == repoTree.repo && repoTree.gitGraph",
          "group": "inline@4"
        },
        {
          "command": "repoTree.viewCommitGraph",
          "when": "view == repoTree.repositories && viewItem == repoTree.repo && repoTree.gitLens",
          "group": "inline@4"
        },
        {
          "submenu": "repoTree.repoMore",
          "when": "view == repoTree.repositories && viewItem == repoTree.repo",
          "group": "inline@5"
        },
        {
          "command": "repoTree.unstageAllInScope",
          "when": "view == repoTree.repositories && viewItem == repoTree.section.staged && config.git.enabled && !git.missing",
          "group": "inline@1"
        },
        {
          "command": "repoTree.unstageAllInScope",
          "when": "view == repoTree.repositories && viewItem == repoTree.section.staged",
          "group": "navigation@1"
        },
        {
          "command": "repoTree.unstageAllInScope",
          "when": "view == repoTree.repositories && viewItem == repoTree.scmChangeDir.staged && config.git.enabled && !git.missing",
          "group": "inline@1"
        },
        {
          "command": "repoTree.unstageAllInScope",
          "when": "view == repoTree.repositories && viewItem == repoTree.scmChangeDir.staged",
          "group": "navigation@1"
        },
        {
          "command": "repoTree.stageAllInScope",
          "when": "view == repoTree.repositories && viewItem == repoTree.section.changes && config.git.enabled && !git.missing",
          "group": "inline@1"
        },
        {
          "command": "repoTree.discardAllInScope",
          "when": "view == repoTree.repositories && viewItem == repoTree.section.changes && config.git.enabled && !git.missing",
          "group": "inline@2"
        },
        {
          "command": "repoTree.stageAllInScope",
          "when": "view == repoTree.repositories && viewItem == repoTree.section.changes",
          "group": "navigation@1"
        },
        {
          "command": "repoTree.discardAllInScope",
          "when": "view == repoTree.repositories && viewItem == repoTree.section.changes",
          "group": "navigation@2"
        },
        {
          "command": "repoTree.stageAllInScope",
          "when": "view == repoTree.repositories && viewItem == repoTree.scmChangeDir.changes && config.git.enabled && !git.missing",
          "group": "inline@1"
        },
        {
          "command": "repoTree.discardAllInScope",
          "when": "view == repoTree.repositories && viewItem == repoTree.scmChangeDir.changes && config.git.enabled && !git.missing",
          "group": "inline@2"
        },
        {
          "command": "repoTree.stageAllInScope",
          "when": "view == repoTree.repositories && viewItem == repoTree.scmChangeDir.changes",
          "group": "navigation@1"
        },
        {
          "command": "repoTree.discardAllInScope",
          "when": "view == repoTree.repositories && viewItem == repoTree.scmChangeDir.changes",
          "group": "navigation@2"
        },
        {
          "command": "repoTree.stageAllInScope",
          "when": "view == repoTree.repositories && viewItem == repoTree.section.merge && config.git.enabled && !git.missing",
          "group": "inline@1"
        },
        {
          "command": "repoTree.stageAllInScope",
          "when": "view == repoTree.repositories && viewItem == repoTree.section.merge",
          "group": "navigation@1"
        },
        {
          "command": "repoTree.stageAllInScope",
          "when": "view == repoTree.repositories && viewItem == repoTree.scmChangeDir.merge && config.git.enabled && !git.missing",
          "group": "inline@1"
        },
        {
          "command": "repoTree.stageAllInScope",
          "when": "view == repoTree.repositories && viewItem == repoTree.scmChangeDir.merge",
          "group": "navigation@1"
        },
        {
          "command": "repoTree.unstageFile",
          "when": "view == repoTree.repositories && viewItem == repoTree.scmFile.staged && config.git.enabled && !git.missing",
          "group": "inline@1"
        },
        {
          "command": "repoTree.stageFile",
          "when": "view == repoTree.repositories && viewItem == repoTree.scmFile.changes && config.git.enabled && !git.missing",
          "group": "inline@1"
        },
        {
          "command": "repoTree.discardFile",
          "when": "view == repoTree.repositories && viewItem == repoTree.scmFile.changes && config.git.enabled && !git.missing",
          "group": "inline@2"
        },
        {
          "command": "repoTree.stageFile",
          "when": "view == repoTree.repositories && viewItem == repoTree.scmFile.merge && config.git.enabled && !git.missing",
          "group": "inline@1"
        },
        {
          "command": "repoTree.openFile",
          "when": "view == repoTree.repositories && viewItem =~ /^repoTree\\.scmFile\\./ && config.git.enabled && !git.missing",
          "group": "inline@3"
        },
        {
          "command": "repoTree.openDiff",
          "when": "view == repoTree.repositories && viewItem =~ /^repoTree\\.scmFile\\./",
          "group": "navigation@1"
        },
        {
          "command": "repoTree.openFile",
          "when": "view == repoTree.repositories && viewItem =~ /^repoTree\\.scmFile\\./",
          "group": "navigation@2"
        },
        {
          "command": "repoTree.unstageFile",
          "when": "view == repoTree.repositories && viewItem == repoTree.scmFile.staged",
          "group": "navigation@3"
        },
        {
          "command": "repoTree.stageFile",
          "when": "view == repoTree.repositories && viewItem == repoTree.scmFile.changes",
          "group": "navigation@3"
        },
        {
          "command": "repoTree.discardFile",
          "when": "view == repoTree.repositories && viewItem == repoTree.scmFile.changes",
          "group": "navigation@4"
        },
        {
          "command": "repoTree.stageFile",
          "when": "view == repoTree.repositories && viewItem == repoTree.scmFile.merge",
          "group": "navigation@3"
        },
        {
          "command": "repoTree.addToGitignore",
          "when": "view == repoTree.repositories && viewItem == repoTree.scmFile.changes",
          "group": "navigation@5"
        },
        {
          "command": "repoTree.addToGitignore",
          "when": "view == repoTree.repositories && viewItem == repoTree.scmChangeDir.changes",
          "group": "navigation@3"
        }
      ],
      "repoTree.repoMore": [
        {
          "command": "repoTree.gitPull",
          "when": "config.git.enabled && !git.missing",
          "group": "1_pullpush@1"
        },
        {
          "command": "repoTree.gitPush",
          "when": "config.git.enabled && !git.missing",
          "group": "1_pullpush@2"
        },
        {
          "command": "repoTree.revealInExplorer",
          "group": "2_view@1"
        },
        {
          "command": "repoTree.openInNewWindow",
          "group": "2_view@2"
        }
      ]
    },
    "submenus": [
      {
        "id": "repoTree.repoMore",
        "label": "Repository Actions",
        "icon": "$(ellipsis)"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test out/tree.test.js out/scmTree.test.js out/gitignore.test.js out/treeExpansion.test.js",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.7.0"
  }
}
